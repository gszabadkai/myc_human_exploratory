# Large snapshots and generated artefacts - not on origin.
# data/from_validation/ holds ~560 MB of derived .rds copied from
# myc_human_validation. It is REGENERABLE by re-copying from that repo at the
# SHA recorded in data/from_validation/README.md - which is why it is ignored
# and the README is not.
data/from_validation/*
!data/from_validation/README.md

# data/raw/depmap is a SYMLINK into myc_human_validation/data/raw/depmap.
# Ignored because git would otherwise track it as a link object that resolves
# only on this machine, and because the ~1.2 GB it points at is gitignored
# there too. The README is tracked and is the only record this repo has of it.
data/raw/depmap
!data/raw/depmap_README.md

results/*
!results/.gitkeep
outputs/*
!outputs/.gitkeep

.Rhistory
.RData
.Rproj.user/
*.Rproj
.DS_Store

# Stray device output from headless Rscript runs
Rplots.pdf
